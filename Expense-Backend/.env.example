# Copy this file to .env and fill in real values. Never commit .env itself.

# Django
DJANGO_SECRET_KEY=change-this-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Neon Postgres connection string.
# Get this from the Neon console: Project -> Connection Details -> "Connection string".
# It already includes sslmode=require, which Neon requires.
# Leave unset to fall back to a local SQLite database (db.sqlite3).
DATABASE_URL=postgresql://<user>:<password>@<host>.neon.tech/<database>?sslmode=require
